# Server
SERVER_ADDR=0.0.0.0:8080
# TLS is usually terminated in front of the server (cloudflared, reverse proxy).
# TLS_CERT_FILE=
# TLS_KEY_FILE=
# Proxies allowed to set the client address: CIDRs, or `cloudflare` for its ranges.
# With cloudflared, list the address cloudflared connects from.
# TRUSTED_PROXIES=127.0.0.1/32,::1/128,cloudflare
# REAL_IP_HEADER=CF-Connecting-IP

# MySQL or MariaDB; the schema is created and extended on startup.
DATABASE_URL=mysql://axochat:password@localhost:3306/axochat

# Messages
MESSAGE_MAX_LENGTH=100
MESSAGE_MAX_MESSAGES=40
MESSAGE_COUNT_DURATION=1m

# LiquidBounce Account login. Staff are the users with a staff role in the Service API.
# API_URL=https://api.liquidbounce.net
# API_TOKEN=

# Moderation: line-separated UUIDs, created if missing. Bans are appended at runtime.
BANNED_FILE=./banned.txt

# JWT login, disabled without JWT_SECRET. Leave unused variables unset, not empty.
# JWT_SECRET=
# JWT_ALGORITHM=HS256
# JWT_VALID_TIME=30d

# Logging
RUST_LOG=info
